<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ToolsByLalan - All Print Tools</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:Arial}
body{background:#f0f4f8;padding:20px}
